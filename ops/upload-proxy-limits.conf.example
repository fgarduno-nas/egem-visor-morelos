# Preparado, NO aplicado. Incluir solo dentro del servidor HTTPS vigente.
# Conservar client_max_body_size 120M y toda la configuración TLS/Certbot.
# El marcador de mantenimiento se retira solo tras backend+Pages verificados.
location = /api/v1/layers {
    if ($request_method = POST) { return 503; } # EGEM_UPLOAD_MAINTENANCE
    proxy_pass http://localhost:4000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 240s;
}
location = /api/v1/layers/ {
    if ($request_method = POST) { return 503; } # EGEM_UPLOAD_MAINTENANCE
    proxy_pass http://localhost:4000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 240s;
}
